# Taek Shops - example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only variables listed here are recognised by src/server/config/env.ts.

# ----------------------------------------------------------------------------
# Core application
# ----------------------------------------------------------------------------
# Public base URL of the running app (used for absolute links, callbacks).
NEXT_PUBLIC_APP_URL=
# Runtime environment: development | test | production (usually set by tooling).
NODE_ENV=

# ----------------------------------------------------------------------------
# Database (PostgreSQL) - REQUIRED from Phase 2 onward
# ----------------------------------------------------------------------------
# Prisma connection string. Example for the local docker-compose Postgres:
#   postgresql://taek:<POSTGRES_PASSWORD>@localhost:5432/taek_shops?schema=public
DATABASE_URL=
# Optional non-pooled connection for `prisma migrate` when the app connects
# through a pooler (e.g. PgBouncer). Leave blank if not applicable.
DIRECT_DATABASE_URL=
# Optional shadow database for `prisma migrate dev` on managed hosts that
# forbid creating databases. Leave blank for local Postgres.
SHADOW_DATABASE_URL=

# Local docker-compose Postgres (used by docker-compose.yml only).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# ----------------------------------------------------------------------------
# Authentication (Auth.js) - required from the auth phase onward
# ----------------------------------------------------------------------------
AUTH_SECRET=
AUTH_URL=

# ----------------------------------------------------------------------------
# Payment provider (Stripe) - behind a replaceable interface
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ----------------------------------------------------------------------------
# Object storage (S3-compatible) - product images
# ----------------------------------------------------------------------------
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ----------------------------------------------------------------------------
# Spreadsheet import limits (safe defaults live in code)
# ----------------------------------------------------------------------------
IMPORT_MAX_FILE_SIZE_BYTES=
IMPORT_MAX_ROW_COUNT=
