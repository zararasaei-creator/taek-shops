# Taek Shops - example environment configuration.
# Copy to `.env` and fill in real values. NEVER commit `.env`.
# Only variables listed here are recognised by src/server/config/env.ts.

# ----------------------------------------------------------------------------
# Core application
# ----------------------------------------------------------------------------
# Public base URL of the running app (used for absolute links, callbacks).
NEXT_PUBLIC_APP_URL=
# Runtime environment: development | test | production (usually set by tooling).
NODE_ENV=

# ----------------------------------------------------------------------------
# Database (PostgreSQL) - REQUIRED from Phase 2 onward
# ----------------------------------------------------------------------------
# Prisma connection string. Example for the local docker-compose Postgres:
#   postgresql://taek:<POSTGRES_PASSWORD>@localhost:5432/taek_shops?schema=public
DATABASE_URL=
# Optional non-pooled connection for `prisma migrate` when the app connects
# through a pooler (e.g. PgBouncer). Leave blank if not applicable.
DIRECT_DATABASE_URL=
# Optional shadow database for `prisma migrate dev` on managed hosts that
# forbid creating databases. Leave blank for local Postgres.
SHADOW_DATABASE_URL=

# Local docker-compose Postgres (used by docker-compose.yml only).
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

# ----------------------------------------------------------------------------
# Integration tests (tests/integration) - REQUIRED to run `npm run test:integration`
# ----------------------------------------------------------------------------
# A database DISTINCT from DATABASE_URL above — never the application's own
# database. `tests/integration/helpers/setup.ts` refuses to run (fail-closed)
# if this is unset, matches DATABASE_URL, or shares its database name.
# Local setup: create a dedicated role + database on the same local Postgres
# (a role whose privileges are limited to that one database, e.g. `taek_test`
# owning `taek_shops_test`), then set this to that role's connection string:
#   postgresql://taek_test:<password>@localhost:5432/taek_shops_test?schema=public
# Prisma migrations are applied to it explicitly (never via the app's own
# `db:deploy`/`db:seed`, which target DATABASE_URL) — see
# tests/integration/README.md for the exact commands.
TEST_DATABASE_URL=

# ----------------------------------------------------------------------------
# Authentication (Phase 3)
# ----------------------------------------------------------------------------
# Optional server-side pepper for session / verification token hashing (>=16
# chars). Strongly recommended in production. Generate: `openssl rand -base64 32`
AUTH_SECRET=
AUTH_URL=
# Argon2id cost parameters (OWASP defaults if unset: 19456 / 2 / 1).
AUTH_ARGON_MEMORY_KIB=
AUTH_ARGON_TIME_COST=
AUTH_ARGON_PARALLELISM=

# ----------------------------------------------------------------------------
# Development admin seed (prisma/seed.ts) - SEED / DEV ONLY, never production
# ----------------------------------------------------------------------------
# When BOTH are set, `npm run db:seed` creates/ensures one ADMIN user.
# The password is hashed with Argon2id and never printed.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
# Set to "true" to re-hash the admin password on re-seed (default: leave as-is).
SEED_ADMIN_FORCE_PASSWORD=

# ----------------------------------------------------------------------------
# Payment provider (Stripe) - behind the `PaymentGateway` interface (Phase 7)
# ----------------------------------------------------------------------------
# Use TEST-mode keys for development/CI. Payments (and the /checkout/*/payment
# page) are disabled unless BOTH STRIPE_SECRET_KEY and STRIPE_WEBHOOK_SECRET are
# set. Get the webhook secret from `stripe listen` or the Stripe dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ----------------------------------------------------------------------------
# Object storage (S3-compatible) - product images (Phase 9)
# ----------------------------------------------------------------------------
# Local dev/test: local MinIO via `docker compose up -d` (see docker-compose.yml,
# service `minio`). Generate your OWN local-only access key / secret key for
# this — never reuse a real cloud provider's credentials here, and never
# commit real values. A local MinIO URL is a development convenience only;
# it is NOT a production CDN (see docs/architecture.md).
# Leave all six blank to use the local-filesystem storage backend instead
# (served by GET /api/media, no Docker/MinIO required).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=taek-shops-dev-images
# Local-only dev value you generate yourself, e.g.:
#   node -e "console.log('taekdevminio'+require('crypto').randomBytes(4).toString('hex'))"
S3_ACCESS_KEY_ID=
# Local-only dev value you generate yourself, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Use hex, not base64url — a base64url value can start with "-", which
# `mc` (the MinIO CLI, run by docker-compose's `minio-init`) misparses as
# an unrecognised flag rather than a positional argument.
S3_SECRET_ACCESS_KEY=
# Usually the same as S3_ENDPOINT for local dev (both the server and the
# browser reach MinIO at the same address). Differs in a real deployment
# behind a reverse proxy / real CDN.
S3_PUBLIC_BASE_URL=http://localhost:9000
# Only needed if you changed MinIO's default ports in docker-compose.yml.
S3_PORT=
MINIO_CONSOLE_PORT=

# ----------------------------------------------------------------------------
# Spreadsheet import limits (safe defaults live in code)
# ----------------------------------------------------------------------------
IMPORT_MAX_FILE_SIZE_BYTES=
IMPORT_MAX_ROW_COUNT=

# ----------------------------------------------------------------------------
# Email (password reset, email verification, order confirmation/shipping —
# launch-prep milestone, 2026-10-01)
# ----------------------------------------------------------------------------
# Leave EMAIL_TRANSPORT unset for local dev: every email renders to a local
# file under .local/email-previews/ instead of sending anywhere (see
# src/server/auth/mailer.ts and src/server/notifications/order-mailer.ts).
# EMAIL_TRANSPORT=noop suppresses even that (auth emails only — order emails
# have no bare no-op transport).
#
# In production, EMAIL_TRANSPORT MUST be set to something explicit — it is
# "resend" for real delivery; leaving it entirely unset refuses to start
# rather than silently defaulting to a local transport in a real deployment
# (see src/server/email/transport.ts's resolveEmailTransport). Automated
# tests (unit, integration) refuse to select "resend" at all, even if real
# values are present here — see that same function's test-run guard.
#
# Get RESEND_API_KEY from an API key created in the Resend dashboard, scoped
# to "Sending access" only (not "Full access") for this app's use. Never a
# real key in this file — this is the template, not your actual .env.
EMAIL_TRANSPORT=
RESEND_API_KEY=
# "Name <email@yourdomain>" or a bare address. The domain must be verified
# in Resend first (see docs/implementation-roadmap.md's "Launch-readiness
# tracking" section for the owner setup checklist — account, domain
# verification, required DNS records).
EMAIL_FROM_ADDRESS=

# ----------------------------------------------------------------------------
# Rollout boundary for durable payment claims — payment-creation milestone
# ----------------------------------------------------------------------------
# ISO-8601 UTC instant from which EVERY payment attempt is guaranteed to have
# written a durable claim: the last pre-claim application instance stopped,
# plus a margin for in-flight requests (>= 10 min). Set it LATER rather than
# earlier when unsure. Never set it automatically or to "now". Procedure:
# docs/implementation-roadmap.md ("Establishing the rollout boundary").
#
# UNSET FAILS CLOSED: orders with no payment record and no provider search hit
# are preserved (stock stays reserved) and reported as needing configuration /
# reconciliation — an empty value never asserts that no pre-claim orders exist.
# Orders with payment evidence are reconciled normally either way.
PAYMENT_CLAIMS_ACTIVE_SINCE=
